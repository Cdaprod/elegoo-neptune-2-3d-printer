index 0000000..61da850
--- /dev/null
+++ b/Marlin/src/gcode/sd/M794.cpp
@@ -0,0 +1,206 @@
+/** Experimental Neptune RSD/1; upstream af5eb011d08f2a2e19809e38470f678958530b29. */
+#include "../../inc/MarlinConfig.h"
+#if ENABLED(NEPTUNE_SD_READ) && ENABLED(SDSUPPORT)
+#include "../gcode.h"
+#include "../queue.h"
+#include "../../sd/cardreader.h"
+#include "../../module/planner.h"
+#include "../../module/printcounter.h"
+#include "../../MarlinCore.h"
+#include "../../feature/neptune_sd/native_sd.h"
+#include "../../feature/neptune_sd/sha256.h"
+#include <ctype.h>
+#if ENABLED(MKS_WIFI_MODULE)
+  #include "../../lcd/extui/mks_ui/wifi_module.h"
+#endif
+
+namespace {
+  constexpr uint16_t CHUNK = 192;
+  constexpr uint32_t RSD_MAX_BYTES = 52428800UL;
+  const char * const operations[] = {"CAPABILITIES", "LIST", "STAT", "OPEN", "READ", "CLOSE", "CANCEL"};
+  SdFile reading;
+  SHA256_CTX file_hash;
+  uint32_t epoch = 1, generation = 0, session = 0, next_offset = 0, last_sequence = 0;
+  millis_t last_activity = 0;
+  char opened_name[13] = {}, opened_token[49] = {};
+
+  bool idle_machine() {
+    return
+      #if ENABLED(MKS_WIFI_MODULE)
+        wifi_link_state != WIFI_TRANS_FILE &&
+      #endif
+      IsRunning() && card.isMounted() && !card.isFileOpen()
+      && !card.flag.saving && !card.flag.logging && !card.isPrinting()
+      && !print_job_timer.isRunning() && !print_job_timer.isPaused()
+      && !planner.has_blocks_queued();
+  }
+  void close_session() { reading.close(); session = 0; next_offset = 0; }
+  void string_out(const char *s) { while (*s) SERIAL_CHAR(*s++); }
+  void start(const uint8_t op, const uint32_t sequence) {
+    SERIAL_ECHOPGM("RSD1 {\"v\":1,\"op\":\""); string_out(operations[op]);
+    SERIAL_ECHOPGM("\",\"q\":", sequence, ",\"s\":", session);
+  }
+  void error(const char *why) {
+    SERIAL_ECHOPGM(",\"error\":\""); string_out(why); SERIAL_ECHOLNPGM("\"}");
+  }
+  bool alias(const char *name) {
+    const char *dot = strchr(name, '.');
+    if (!dot || dot == name || dot-name > 8 || strchr(dot+1, '.')) return false;
+    for (const char *p=name; p<dot; ++p)
+      if (!isalnum(*p) && *p!='_' && *p!='~' && *p!='-') return false;
+    return !strcmp(dot+1,"GCO") || !strcmp(dot+1,"GC") || !strcmp(dot+1,"G");
+  }
+  bool unsigned_field(const char letter, uint32_t &result) {
+    char key[]=" V"; key[1]=letter;
+    const char *p=strstr(parser.command_ptr,key);
+    if (!p || strstr(p+2,key)) return false;
+    p+=2; result=0;
+    if (!isdigit(*p)) return false;
+    while (isdigit(*p)) {
+      const uint8_t digit=*p++-'0';
+      if (result>(0xFFFFFFFFUL-digit)/10) return false;
+      result=result*10+digit;
+    }
+    return !*p || *p==' ';
+  }
+  bool filename(char *name) {
+    const char *raw = strstr(parser.command_ptr, " P");
+    if (!raw) return false;
+    raw += 2;
+    if (strstr(raw," P")) return false;
+    uint8_t n=0;
+    while (*raw && *raw!=' ') {
+      if (n>=12 || !raw[1] || !raw[2] || !isdigit(raw[0]) || !isdigit(raw[1]) || !isdigit(raw[2])) return false;
+      const uint16_t number = (raw[0]-'0')*100 + (raw[1]-'0')*10 + raw[2]-'0';
+      if (!number || number>127) return false;
+      const char value = number;
+      if (!value || uint8_t(value)>127) return false;
+      name[n++] = toupper(value); raw+=3;
+    }
+    name[n]=0;
+    return alias(name);
+  }
+  bool snapshot(const char *name, char *token, uint32_t &size) {
+    SdFile root = card.getroot(), file;
+    dir_t info;
+    if (!file.open(&root,name,O_READ) || !file.isFile() || !file.dirEntry(&info)) {
+      file.close(); return false;
+    }
+    size = file.fileSize();
+    snprintf(token,49,"%08lx%08lx%08lx%04x%04x%04x%04x",
+      (unsigned long)epoch,(unsigned long)file.firstCluster(),(unsigned long)size,
+      info.creationDate,info.creationTime,info.lastWriteDate,info.lastWriteTime);
+    file.close();
+    return size && size<=RSD_MAX_BYTES;
+  }
+  void metadata(const char *token, uint32_t size) {
+    SERIAL_ECHOPGM(",\"size\":",size,",\"token\":\""); string_out(token); SERIAL_CHAR('"');
+  }
+  uint32_t crc32(const uint8_t *data, uint16_t count) {
+    uint32_t crc=0xFFFFFFFFUL;
+    while (count--) {
+      crc ^= *data++;
+      for (uint8_t bit=0; bit<8; ++bit) crc=(crc>>1)^((crc&1)?0xEDB88320UL:0);
+    }
+    return ~crc;
+  }
+}
+
+void native_sd_invalidate() { close_session(); if (++epoch==0) epoch=1; }
+void native_sd_tick() {
+  if (session && (!idle_machine() || ELAPSED(millis(),last_activity+15000UL))) close_session();
+}
+
+void GcodeSuite::M794() {
+  uint32_t operation=255, sequence=0, version=0, requested_session=0, request_offset=0, request_count=0;
+  const bool well_formed=unsigned_field('O',operation) && unsigned_field('Q',sequence)
+    && unsigned_field('V',version) && unsigned_field('S',requested_session)
+    && unsigned_field('A',request_offset) && unsigned_field('B',request_count);
+  const uint32_t op=operation;
+  if (op>6) return; // Unknown operation cannot touch the filesystem.
+  native_sd_tick();
+  // Only configured primary USB UART; never WiFi UART or SD/injected commands.
+  if (queue.ring_buffer.command_port().index != 0 || !well_formed || !sequence || version!=1) {
+    start(op,sequence); error("VERSION_OR_TRANSPORT"); return;
+  }
+  if (!idle_machine()) { start(op,sequence); error("BUSY_OR_MEDIA"); return; }
+  if (op>=4 && (!session || requested_session!=session || sequence<=last_sequence)) {
+    start(op,sequence); error("SESSION_OR_SEQUENCE"); return;
+  }
+  last_activity=millis();
+  if (op==0) {
+    start(op,sequence); SERIAL_ECHOLNPGM(",\"chunk\":192,\"max_bytes\":52428800,\"hash\":\"sha256\"}"); return;
+  }
+  if (op==1) {
+    const uint32_t cursor=request_offset;
+    if (cursor>=4096) { start(op,sequence); error("LIMIT"); return; }
+    SdFile root=card.getroot();
+    root.rewind();
+    uint16_t found=0, scanned=0;
+    char name[13], long_name[LONG_FILENAME_LENGTH];
+    dir_t info;
+    while (scanned++<4096 && root.readDir(&info,long_name)>0) {
+      SdFile::dirName(info,name);
+      const uint32_t size=info.fileSize;
+      if (!DIR_IS_FILE(&info) || !alias(name) || !size || size>RSD_MAX_BYTES) continue;
+      if (found++==cursor) {
+        start(op,sequence); SERIAL_ECHOPGM(",\"name\":\""); string_out(name);
+        SERIAL_ECHOPGM("\",\"size\":",size,",\"display_hex\":\"");
+        const char *display = long_name[0] ? long_name : name;
+        constexpr char digits[]="0123456789abcdef";
+        for (uint16_t i=0; display[i] && i<200; ++i) {
+          const uint8_t c=display[i]; SERIAL_CHAR(digits[c>>4],digits[c&15]);
+        }
+        SERIAL_ECHOLNPGM("\"}"); return;
+      }
+    }
+    start(op,sequence); SERIAL_ECHOLNPGM(",\"end\":true}"); return;
+  }
+  if (op==2 || op==3) {
+    char name[13], token[49]; uint32_t size;
+    if (!filename(name) || !snapshot(name,token,size)) {
+      start(op,sequence); error("PATH_OR_FILE"); return;
+    }
+    if (op==3) {
+      if (session) { start(op,sequence); error("BUSY"); return; }
+      SdFile root=card.getroot();
+      if (!reading.open(&root,name,O_READ)) { start(op,sequence); error("IO"); return; }
+      if (++generation==0) ++generation;
+      session=generation; next_offset=0; last_sequence=sequence; sha256_init(&file_hash);
+      strcpy(opened_name,name); strcpy(opened_token,token);
+    }
+    start(op,sequence); metadata(token,size); SERIAL_ECHOLNPGM("}"); return;
+  }
+  char token[49]; uint32_t size;
+  if (!snapshot(opened_name,token,size) || strcmp(token,opened_token)) {
+    start(op,sequence); error("CHANGED"); close_session(); return;
+  }
+  last_sequence=sequence;
+  if (op==5 || op==6) {
+    start(op,sequence);
+    if (op==5) {
+      if (next_offset!=size) { error("INCOMPLETE"); close_session(); return; }
+      uint8_t digest[32]; sha256_final(&file_hash,digest);
+      constexpr char digits[]="0123456789abcdef";
+      SERIAL_ECHOPGM(",\"sha256\":\"");
+      for (uint8_t i=0; i<32; ++i) SERIAL_CHAR(digits[digest[i]>>4],digits[digest[i]&15]);
+      SERIAL_CHAR('"');
+    }
+    SERIAL_ECHOLNPGM("}"); close_session(); return;
+  }
+  const uint32_t offset=request_offset, count=request_count;
+  if (offset!=next_offset || !count || count>CHUNK || offset>size || count>size-offset) {
+    start(op,sequence); error("OFFSET_OR_LIMIT"); return;
+  }
+  uint8_t data[CHUNK];
+  if (!reading.seekSet(offset) || reading.read(data,count)!=int16_t(count)) {
+    start(op,sequence); error("IO"); close_session(); return;
+  }
+  sha256_update(&file_hash,data,count);
+  start(op,sequence); SERIAL_ECHOPGM(",\"offset\":",offset,",\"token\":\""); string_out(token);
+  SERIAL_ECHOPGM("\",\"crc\":",crc32(data,count),",\"data\":\"");
+  constexpr char digits[]="0123456789abcdef";
+  for (uint16_t i=0; i<count; ++i) SERIAL_CHAR(digits[data[i]>>4],digits[data[i]&15]);
+  SERIAL_ECHOLNPGM("\"}"); next_offset+=count;
+}
+#endif
