#!/bin/sh
set -eu

# s6 cont-init runs with a restricted PATH; use the interpreter from the image.
PYTHON=/usr/local/bin/python3
if [ ! -x "$PYTHON" ]; then
  echo '[neptune-plugins] ERROR: expected OctoPrint Python executable missing' >&2
  exit 1
fi

echo "[neptune-plugins] Installing bundled plugins into active OctoPrint Python..."
"$PYTHON" -m pip install --no-index --find-links=/opt/octoprint-plugin-wheels \
  'OctoPrint-Remote_connection==0.1.1' 'Themeify==1.2.2' 'Print-Job-History==1.17.5' \
  'OctoPrint-Preheat==0.9.0' 'OctoPrint-SpoolManager==1.7.8' \
  'OctoPrint-FilamentManager==1.9.1' 'OctoPrint-DisplayLayerProgress==1.28.0' \
  'OctoPrint-UltimakerFormatPackage==1.2.0' 'OctoPrint-PrusaSlicerThumbnails==1.2.4' \
  'OctoPrint-CostEstimation==3.6.0'

echo "[neptune-plugins] Checking OctoPrint plugin entry points..."
"$PYTHON" - <<'PY'
from importlib.metadata import entry_points
found = {ep.name for ep in entry_points(group="octoprint.plugin")}
required = {"remote_connection", "themeify", "PrintJobHistory", "preheat", "SpoolManager", "filamentmanager", "DisplayLayerProgress", "UltimakerFormatPackage", "prusaslicerthumbnails", "costestimation"}
missing = required - found
if missing:
    raise SystemExit(f"Missing OctoPrint plugin entry points: {sorted(missing)}")
print(f"[neptune-plugins] Verified: {', '.join(sorted(required))}")
PY
