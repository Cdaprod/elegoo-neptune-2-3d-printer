# Copy to .env, set your printer hostname/IP, and replace with a unique token.
NEPTUNE_OBSERVATORY_TOKEN=replace-with-a-long-random-token
MKS_WIFI_HOST=printer.local
MKS_WIFI_PORT=8080

# Optional read-only index of local OrcaSlicer exports. Recommended: set OrcaSlicer
# to export to a stable folder on this Mac, then point this at that existing folder.
# The printer's SD card can stay installed. Start Observatory with:
# docker compose -f compose.yaml -f compose.neptune-volume.yaml up -d --build
# The source folder is mounted read-only; Observatory stores only thumbnails and
# selected metadata in its persistent database. Legacy mounted-volume setting also works.
# NEPTUNE_GCODE_SOURCE_PATH=/absolute/path/to/OrcaSlicer/exports
# NEPTUNE_GCODE_VOLUME_PATH=/Volumes/NEPTUNE

# Optional overrides:
# NEPTUNE_POLL_INTERVAL_SECONDS=2
# Position reporting sends read-only M114. This firmware has not returned usable
# position coordinates in prior tests; leave disabled unless intentionally queried.
# NEPTUNE_MOTION_POLLING_ENABLED=false
# NEPTUNE_MOTION_QUERY_ENABLED=false
# NEPTUNE_MOTION_POLL_INTERVAL_SECONDS=10

# Operator Mode is disarmed on every startup. Use your existing dashboard sign-in
# to arm it; no separate control credential is needed.
# Control execution is available after dashboard Operator Mode is armed.
# The session starts disarmed after every service restart.
NEPTUNE_CONTROL_EXECUTION_ENABLED=true
# NEPTUNE_COMMAND_TIMEOUT_SECONDS=15
# NEPTUNE_CAPABILITY_REGISTRY_PATH=/data/capability-registry.json
# Hot extrusion is blocked below this nozzle temperature.
NEPTUNE_EXTRUSION_MIN_TEMP_C=180
# Wireless SD upload is source-documented but unverified on the installed firmware.
# Keep off until separately supervised and confirmed on this exact printer.
# NEPTUNE_SD_UPLOAD_ENABLED=false
# Legacy one-operation Cooldown gate. If enabled, it uses the existing dashboard
# sign-in and remains one-time; normal Cooldown uses Operator Mode instead.
# NEPTUNE_COOLDOWN_COMMISSIONING_ENABLED=false
