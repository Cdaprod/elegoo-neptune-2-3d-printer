# Observed on Raspberry Pi OS Trixie ARM64; native touch scrolling verified on the commissioned Pi.
DISPLAY_OUTPUT=HDMI-A-1
DISPLAY_NATIVE_MODE=400x1280
DISPLAY_LOGICAL_MODE=1280x400
DISPLAY_REFRESH_HZ=60.234001
DISPLAY_TRANSFORM=90
DISPLAY_SCALE=1.0
DISPLAY_POSITION=0,0
# Reference only: never automatically override working EDID.
LEGACY_HDMI_TIMINGS='400 0 100 10 140 1280 10 20 20 2 0 0 0 60 0 43000000 3'

# Observed USB HID identity; event node is dynamically assigned.
TOUCH_USB_VENDOR_ID=0712
TOUCH_USB_PRODUCT_ID=000a
TOUCH_DRIVER=hid-multitouch
TOUCH_DEVICE_NAME="WaveShare WaveShare"

TOUCH_MAP_OUTPUT=HDMI-A-1
TOUCH_MOUSE_EMULATION=no
TOUCH_CALIBRATION_MATRIX='0 1 0 -1 0 1'
