# Root docker compose uses BOTH services on one Compose network.
# cp .env.example .env  (root directory; do not commit .env)
# Run 'make up': this automatically generates the Observatory login token,
# then requests an OctoPrint-issued application key through its approval dialog.
# Never enter your OctoPrint password into this file or commit credentials.
NEPTUNE_OBSERVATORY_TOKEN=replace-with-long-random-local-observatory-token
OCTOPRINT_API_KEY=

# Printer's MKS WiFi hostname or LAN IP, NOT the OctoPrint host IP.
# OctoPrint is the sole raw TCP client of this endpoint.
OCTOPRINT_MKS_WIFI_HOST=192.168.0.95
OCTOPRINT_MKS_WIFI_PORT=8080
# Optional, safe MKS HTTP status GET (no additional raw TCP or G-code).
NEPTUNE_MKS_HTTP_MONITOR_ENABLED=true
NEPTUNE_MKS_HTTP_PORT=80
NEPTUNE_MKS_HTTP_TIMEOUT_SECONDS=1.5
# Keep false for initial commissioning. When true, startup may connect to printer.
OCTOPRINT_MKS_AUTO_CONNECT=false

# OctoPrint browser UI on the LAN; internal Observatory API always uses octoprint:80.
OCTOPRINT_BIND_ADDRESS=0.0.0.0
OCTOPRINT_HOST_PORT=5001
# Observer UI is served on port 8000 by the included integration.
NEPTUNE_OCTOPRINT_CONTROLS_ENABLED=false
# Optional operator-authorized G-code file import into OctoPrint LOCAL storage only.
# This is not printer SD upload or a print-start permission.
NEPTUNE_HMI_IMPORT_ENABLED=false
# Experimental RSD/1 firmware + OctoPrint USB owner required; never enables flashing.
NEPTUNE_NATIVE_SD_READ_ENABLED=false

# Optional Print Bay / Manufacturing as Code. Source manifests are trusted code.
NEPTUNE_MANUFACTURING_STORAGE=/data/manufacturing
NEPTUNE_MANUFACTURING_PROJECTS=/data/manufacturing/projects
NEPTUNE_MANUFACTURING_UPLOAD_ENABLED=false
NEPTUNE_MANUFACTURING_PRINTER=neptune-2
# Pi deployment-agent overlay only; use the Mac Observatory origin and its token.
NEPTUNE_BUILD_NODE_URL=
NEPTUNE_BUILD_NODE_TOKEN=
# Native Mac build worker (set actual installed executable paths):
# FREECAD_CMD=/Applications/FreeCAD.app/Contents/Resources/bin/freecadcmd
# ORCASLICER_PATH=/Applications/OrcaSlicer.app/Contents/MacOS/OrcaSlicer
# NEPTUNE_SD_MOUNT=/Volumes/NEPTUNE
# NEPTUNE_MANUFACTURING_INVENTORY=/path/to/CAD:/path/to/Orca

# Only after approved USB/firmware commissioning; keep unset on existing WiFi appliance.
# COMPOSE_FILE=compose.yaml:integrations/octoprint/compose.usb.yaml
# OCTOPRINT_SERIAL_DEVICE=/dev/serial/by-id/<verified-printer-device>

# Explicit USB migration uses scripts/check_usb_owner.py --configure-usb.
OCTOPRINT_TRANSPORT=wifi
# Read-only factory queries do not enable file selection or SD initialization.
NEPTUNE_FACTORY_USB_SELECTION_ENABLED=false
