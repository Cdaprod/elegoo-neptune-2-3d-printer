# Root docker compose uses BOTH services on one Compose network.
# cp .env.example .env  (root directory; do not commit .env)
# Run 'make up': this automatically generates the Observatory login token,
# then requests an OctoPrint-issued application key through its approval dialog.
# Never enter your OctoPrint password into this file or commit credentials.
NEPTUNE_OBSERVATORY_TOKEN=replace-with-long-random-local-observatory-token
OCTOPRINT_API_KEY=

# Printer's MKS WiFi hostname or LAN IP, NOT the OctoPrint host IP.
# OctoPrint is the sole raw TCP client of this endpoint.
OCTOPRINT_MKS_WIFI_HOST=192.168.0.95
OCTOPRINT_MKS_WIFI_PORT=8080
# Keep false for initial commissioning. When true, startup may connect to printer.
OCTOPRINT_MKS_AUTO_CONNECT=false

# OctoPrint browser UI on the LAN; internal Observatory API always uses octoprint:80.
OCTOPRINT_BIND_ADDRESS=0.0.0.0
OCTOPRINT_HOST_PORT=5001
# Observer UI is served on port 8000 by the included integration.
NEPTUNE_OCTOPRINT_CONTROLS_ENABLED=false
